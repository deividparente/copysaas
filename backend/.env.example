# ================================
# RAIAR MENSAGENS - CONFIGURAÇÃO
# ================================

# DATABASE
# --------
# Para desenvolvimento local (SQLite):
DATABASE_URL="file:./dev.db"

# Para produção (PostgreSQL):
# DATABASE_URL="postgresql://user:password@db.example.com:5432/raiar_mensagens"

# Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Railway PostgreSQL:
# DATABASE_URL="postgresql://user:password@railway-prod.proxy.rlwy.net:5432/database"

# SEGURANÇA
# --------
# Gere uma chave JWT segura com: openssl rand -hex 32
JWT_SECRET="sua-chave-jwt-super-secreta-aqui"

# URLs
# ----
# URL do Frontend (obrigatório para CORS)
FRONTEND_URL="http://localhost:3000"

# URL da API (para requisições do frontend)
NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# AMBIENTE
# --------
# Valores: development, production, staging
NODE_ENV="development"
