# ========================================
# RAIAR MENSAGENS - VARIÁVEIS DE AMBIENTE
# ========================================

# DATABASE
# Gere uma senha segura: openssl rand -hex 16
DB_PASSWORD=gere-uma-senha-segura-aqui-com-openssl-rand-hex-16

# JWT
# Gere uma chave segura: openssl rand -hex 32
JWT_SECRET=gere-uma-chave-segura-aqui-com-openssl-rand-hex-32

# URLs (use seus domínios aqui)
FRONTEND_URL=http://copy.dparente.site/
BACKEND_URL=http://copys.dparente.site/

# NODE ENV
NODE_ENV=production

# ========================================
# INSTRUÇÕES:
# ========================================
# 1. Substitua DB_PASSWORD com uma senha segura
# 2. Substitua JWT_SECRET com uma chave aleatória
# 3. FRONTEND_URL: URL do frontend (sem /api)
# 4. BACKEND_URL: URL do backend (sem /api)
# 5. NODE_ENV: sempre "production" para Coolify
#
# Comando para gerar senhas seguras:
# openssl rand -hex 16   (para DB_PASSWORD)
# openssl rand -hex 32   (para JWT_SECRET)
# ========================================
